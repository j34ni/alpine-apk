# Maintainer: Jean Iaquinta <jeani@uio.no>
pkgname=mpich
pkgver=5.0.2_rc2
_ver=${pkgver/_/}
pkgrel=0
pkgdesc="High-quality portable implementation of the Message Passing Interface (MPI) standard"
url="https://www.mpich.org/"
license="LicenseRef-MPICH" # MIT-style with export/acknowledgement clauses, as on conda-forge
arch="x86_64 aarch64"
options="!check" # test suite is not self-contained (long-running, device-dependent)
makedepends="
	bison
	curl-dev
	flex
	gfortran
	hwloc-dev
	json-c-dev
	libcxi-dev
	libfabric-dev
	m4
	perl
	python3
	rdma-core-dev
	xpmem-dev
	"
subpackages="$pkgname-dev $pkgname-doc"
source="https://www.mpich.org/static/downloads/$_ver/mpich-$_ver.tar.gz
	rma-am-tag.patch
	"
builddir="$srcdir/$pkgname-$_ver"

build() {
	# gfortran >= 10 aborts on mismatched dummy/actual args in MPICH Fortran
	export FFLAGS="-fallow-argument-mismatch ${FFLAGS:-}"
	export FCFLAGS="-fallow-argument-mismatch ${FCFLAGS:-}"

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc/mpich \
		--disable-doc \
		--disable-dependency-tracking \
		--disable-option-checking \
		--disable-static \
		--enable-cxx \
		--enable-f08 \
		--enable-fortran=all \
		--enable-romio \
		--with-device=ch4:ofi \
		--with-hwloc=/usr \
		--with-libfabric=/usr \
		--with-libfabric-include=/usr/include \
		--with-libfabric-lib=/usr/lib \
		--with-pm=hydra:gforker \
		--with-wrapper-dl-type=none \
		--with-dl-type=none \
		--with-xpmem=/usr \
		--with-xpmem-include=/usr/include \
		--with-xpmem-lib=/usr/lib
	make
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.la

	# rc suffix: abuild rejects "5.0.2rc2" as a pkgconfig provides version
	local pc; for pc in "$pkgdir"/usr/lib/pkgconfig/*.pc; do
		[ -f "$pc" ] && sed -i "s/^Version: $_ver\$/Version: ${pkgver%%_*}/" "$pc"
	done

	install -d "$pkgdir"/usr/share/licenses/$pkgname
	install -m 644 COPYRIGHT "$pkgdir"/usr/share/licenses/$pkgname/
}

dev() {
	default_dev

	local i; for i in mpicc mpicxx mpic++ mpiCC mpifort mpif90 mpif77; do
		if [ -e "$pkgdir"/usr/bin/$i ]; then
			amove usr/bin/$i
		fi
	done
}

