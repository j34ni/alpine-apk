# Maintainer: Jean Iaquinta <jeani@uio.no>
pkgname=scalapack
pkgver=2.2.0
pkgrel=0
pkgdesc="Highly scalable linear algebra library for distributed-memory message-passing computers"
url="https://www.netlib.org/scalapack/"
license="BSD-2-Clause"
arch="x86_64 aarch64"
makedepends="
	cmake
	gfortran
	mpich-dev
	openblas-dev
	"
subpackages="$pkgname-dev"
source="
	https://www.netlib.org/scalapack/scalapack-$pkgver.tgz
	high_mem_32bits.patch
	versioned-libscalapack.patch
	"

prepare() {
	default_prepare
}

build() {
	# MPI libraries are not correctly linked by the CMake scripts upstream,
	# so use the MPI compiler wrappers.
	export CC=mpicc
	export CXX=mpic++
	export FC=mpifort
	export FFLAGS="$FFLAGS -fallow-argument-mismatch"
	export CFLAGS="$CFLAGS -std=gnu17 -Wno-error=implicit-function-declaration"
	# BLACS INSTALL sub-configure runs through execute_process() and inherits
	# the environment, not the -D flags passed to the top-level cmake.
	export CMAKE_POLICY_VERSION_MINIMUM=3.5
	export CMAKE_GENERATOR="Unix Makefiles"

	mkdir -p build
	cd build
	cmake -G "Unix Makefiles" \
		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
		-DBLAS_LIBRARIES="-lopenblas" \
		-DLAPACK_LIBRARIES="-lopenblas" \
		-DBUILD_SHARED_LIBS=ON \
		-DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_INSTALL_PREFIX=/usr \
		..
	make
}

package() {
	make -C build DESTDIR="$pkgdir" install
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

