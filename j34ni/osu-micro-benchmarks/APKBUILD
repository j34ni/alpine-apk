# Maintainer: Jean Iaquinta <jeani@uio.no>
pkgname=osu-micro-benchmarks
pkgver=7.5.2
pkgrel=0
pkgdesc="OSU Micro-Benchmarks (MPI point-to-point, collective and one-sided benchmarks)"
url="https://mvapich.cse.ohio-state.edu/benchmarks/"
license="BSD-3-Clause"
arch="x86_64 aarch64"
options="!check" # benchmarks require a provisioned MPI cluster
makedepends="
	gcc
	mpich-dev
	"
source="
	https://mvapich.cse.ohio-state.edu/download/mvapich/osu-micro-benchmarks-$pkgver.tar.gz
	osu-musl.patch
	"

build() {
	CC=mpicc CXX=mpicxx ./configure \
		--prefix=/usr \
		--disable-dependency-tracking \
		--disable-static
	make
}

package() {
	make DESTDIR="$pkgdir" install
	# benchmarks live under libexec; keep bin/ free of clashes
	rm -rf "${pkgdir:?}"/usr/bin

	install -Dm644 COPYRIGHT "$pkgdir"/usr/share/licenses/$pkgname/COPYRIGHT
}

sha512sums="
