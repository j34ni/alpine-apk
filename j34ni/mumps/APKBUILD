# Maintainer: Jean Iaquinta <jeani@uio.no>
pkgname=mumps
pkgver=5.7.3
pkgrel=1
pkgdesc="MUltifrontal Massively Parallel sparse direct Solver (MPICH, PT-Scotch+METIS ordering)"
url="https://mumps-solver.org"
license="CECILL-C"
arch="x86_64"
makedepends="
	gfortran
	metis-dev
	mpich-dev
	openblas-dev
	scalapack-dev
	scotch-dev
	"
subpackages="$pkgname-dev"
source="
	MUMPS_$pkgver.tar.gz::https://mumps-solver.org/MUMPS_$pkgver.tar.gz
	Makefile.inc
	"
builddir="$srcdir/MUMPS_$pkgver"

prepare() {
	cp "$srcdir"/Makefile.inc "$builddir"/Makefile.inc
}

build() {
	make -j"$(nproc)" allshared
}

check() {
	# upstream smoke suite: real sparse LU, 4 ranks exercises PT-Scotch ordering
	make -C examples all
	export LD_LIBRARY_PATH="$builddir/lib:$builddir/PORD/lib"
	cd examples
	./dsimpletest < input_simpletest_real
	mpiexec -n 4 ./dsimpletest < input_simpletest_real
	mpiexec -n 2 ./zsimpletest < input_simpletest_cmplx
}

package() {
	install -d "$pkgdir"/usr/lib "$pkgdir"/usr/include
	install -Dm644 include/*.h -t "$pkgdir"/usr/include
	install -Dm755 lib/*.so -t "$pkgdir"/usr/lib
	# PORD is built in its own directory and is needed to link mumps.
	install -Dm755 PORD/lib/libpord.so -t "$pkgdir"/usr/lib
	install -Dm644 LICENSE \
		"$pkgdir"/usr/share/licenses/$pkgname/CECILL-C
}

dev() {
	default_dev
	install -d "$subpkgdir"/usr/lib/pkgconfig
	for prec in s d c z; do
		cat > "$subpkgdir"/usr/lib/pkgconfig/${prec}mumps.pc <<-EOF
			prefix=/usr
			exec_prefix=\${prefix}
			libdir=\${exec_prefix}/lib
			includedir=\${prefix}/include

			Name: ${prec}mumps
			Description: The parallel ${prec}-precision MUMPS library
			Version: $pkgver
			Cflags: -I\${includedir}
			Libs: -L\${libdir} -l${prec}mumps -lmumps_common -lpord
		EOF
	done
}

