# Maintainer: Jean Iaquinta <jeani@uio.no>
pkgname=mpich
pkgver=5.1.0_alpha1
_commit=3a753339f179bdcd44145bf81f43931d2c20110b
_hwloc=42bebfa5e4b96c99c2482645c8eb86d4755ef23b
_libfabric=a2ff1618e5490a4d8e5da6277d69993149701f2f
_mydef_boot=ea2d6852486755eb12e255f760e2eb62f5446329
_ucx=4020d2be2271da0ac105d824f26ec76ad533577a
pkgrel=0
pkgdesc="High-quality portable implementation of the Message Passing Interface (MPI) standard"
url="https://www.mpich.org/"
license="LicenseRef-MPICH"
arch="x86_64 aarch64 riscv64"
options="!check"
makedepends="
	autoconf
	automake
	bash
	bison
	curl-dev
	flex
	gfortran
	hwloc-dev
	json-c-dev
	libcxi-dev
	libfabric-dev
	libtool
	m4
	patch
	perl
	python3
	rdma-core-dev
	xpmem-dev
	"
subpackages="$pkgname-dev $pkgname-doc"

source="
	mpich-$_commit.tar.gz::https://github.com/pmodels/mpich/archive/$_commit.tar.gz
	hwloc-$_hwloc.tar.gz::https://github.com/pmodels/hwloc/archive/$_hwloc.tar.gz
	libfabric-$_libfabric.tar.gz::https://github.com/pmodels/libfabric/archive/$_libfabric.tar.gz
	mydef_boot-$_mydef_boot.tar.gz::https://github.com/pmodels/mydef_boot/archive/$_mydef_boot.tar.gz
	ucx-$_ucx.tar.gz::https://github.com/pmodels/ucx/archive/$_ucx.tar.gz
	"
builddir="$srcdir/mpich-$_commit"

prepare() {
	default_prepare

	local m
	for m in hwloc:$_hwloc libfabric:$_libfabric mydef_boot:$_mydef_boot ucx:$_ucx; do
		dir=${m%%:*}; sha=${m##*:}
		rm -rf "modules/$dir"
		mv "$srcdir/$dir-$sha" "modules/$dir"
	done

	./autogen.sh
}

build() {
	export FFLAGS="-fallow-argument-mismatch ${FFLAGS:-}"
	export FCFLAGS="-fallow-argument-mismatch ${FCFLAGS:-}"

	./configure \
		--prefix=/usr \
		--sysconfdir=/etc/mpich \
		--disable-doc \
		--disable-dependency-tracking \
		--disable-option-checking \
		--disable-static \
		--enable-cxx \
		--enable-fortran \
		--enable-mpi-abi=both \
		--enable-romio \
		--with-device=ch4:ofi \
		--with-hwloc=/usr \
		--with-libfabric=/usr \
		--with-libfabric-include=/usr/include \
		--with-libfabric-lib=/usr/lib \
		--with-pm=hydra:gforker \
		--with-wrapper-dl-type=none \
		--with-dl-type=none \
		--with-xpmem=/usr \
		--with-xpmem-include=/usr/include \
		--with-xpmem-lib=/usr/lib
	make
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.la

	sed -i "s/^Version: .*/Version: $pkgver/" "$pkgdir"/usr/lib/pkgconfig/*.pc

	install -d "$pkgdir"/usr/share/licenses/$pkgname
	install -m 644 COPYRIGHT "$pkgdir"/usr/share/licenses/$pkgname
}

dev() {
	default_dev

	local i; for i in mpicc mpicxx mpic++ mpiCC mpifort mpif90 mpif77; do
		if [ -e "$pkgdir"/usr/bin/$i ]; then
			amove usr/bin/$i
		fi
	done
}

