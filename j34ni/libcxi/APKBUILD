# Maintainer: Jean Iaquinta <jeani@uio.no>
_realname=shs-libcxi
pkgname=libcxi
pkgver=14.0.1
pkgrel=0
pkgdesc="Userspace driver library for HPE Slingshot (Cassini) NICs"
url="https://github.com/HewlettPackard/shs-libcxi"
license="LGPL-2.1-only OR BSD-3-Clause"
arch="x86_64 aarch64"
options="!check" # unit tests require CXI hardware
depends_dev="
	cassini-headers=$pkgver-r$pkgrel
	cxi-uapi-headers=$pkgver-r$pkgrel
	"
makedepends="
	autoconf
	automake
	cassini-headers
	cxi-uapi-headers
	fuse3-dev
	linux-headers
	libconfig-dev
	libnl3-dev
	libtool
	libuv-dev
	lm-sensors-dev
	numactl-dev
	python3
	pkgconf
	yaml-dev
	"
subpackages="$pkgname-dev $pkgname-doc"
source="
	$_realname-$pkgver.tar.gz::$url/archive/refs/tags/release/shs-$pkgver.tar.gz
	libcxi-musl.patch
	fix-fuse3-configure.patch
	fix-fuse3-stats.patch
	fix-fuse3-rh.patch
	"
builddir="$srcdir/$_realname-release-shs-$pkgver"

prepare() {
	default_prepare
	sed -i 's|../cassini-headers/install/share/cassini-headers/csr_defs.json|/usr/share/cassini-headers/csr_defs.json|g' \
		utils/cxi_dump_csrs.py
	autoreconf -ivf
}

build() {
	./configure \
		--prefix=/usr \
		--with-udevrulesdir=/usr/lib/udev/rules.d \
		--enable-static=no
	make
}

package() {
	make DESTDIR="$pkgdir" install
	rm -f "$pkgdir"/usr/lib/*.la
	install -Dm644 cray-libcxi.spec \
		"$pkgdir"/usr/share/licenses/$pkgname/cray-libcxi.spec
}
