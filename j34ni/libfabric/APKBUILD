f5973af135cc17de6b17b9b85eb8b7f5b55c338e922b6876982345ce7e83970c0a7c4a5c7f439c4d181bf258b35a8f5d28b1973ca676395edbe308a5a1437ff1  libfabric-musl.patch
"
