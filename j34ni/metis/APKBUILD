# Maintainer: Jean Iaquinta <jeani@uio.no>
pkgname=metis
pkgver=5.2.1
pkgrel=0
pkgdesc="Serial graph partitioning and fill-reducing matrix ordering library"
url="https://github.com/KarypisLab/METIS"
license="Apache-2.0"
arch="x86_64 aarch64"
makedepends="
	cmake
	make
	"
subpackages="$pkgname-dev"
source="
	metis-$pkgver.tar.gz::https://github.com/KarypisLab/METIS/archive/v$pkgver.tar.gz
	gklib.tar.gz::https://github.com/KarypisLab/GKlib/archive/8bd6bad750b2b0d90800c632cf18e8ee93ad72d7.tar.gz
	getprocvmpeak.diff
	pr52.patch
	no-march-native.patch
fix-libmetis-install-paths.patch
	cmake-3.5.patch
	versioned-libmetis.patch
	gklib-remove-march-and-werror-flags.patch
	gklib-xopen-source.patch
	gklib-remove-test-with-embedded-assembler.patch
	"
builddir="$srcdir/METIS-$pkgver"

prepare() {
	mkdir -p "$srcdir/METIS-$pkgver"
	cd "$srcdir/METIS-$pkgver"

	patch -p1 -i "$srcdir/getprocvmpeak.diff"
	patch -p1 -i "$srcdir/pr52.patch"
	patch -p1 -i "$srcdir/no-march-native.patch"
	patch -p1 -i "$srcdir/fix-libmetis-install-paths.patch"
	patch -p1 -i "$srcdir/cmake-3.5.patch"
	patch -p1 -i "$srcdir/versioned-libmetis.patch"

	mv "$srcdir/GKlib-8bd6bad750b2b0d90800c632cf18e8ee93ad72d7" GKlib
	cd GKlib
	patch -p1 -i "$srcdir/gklib-remove-march-and-werror-flags.patch"
	patch -p1 -i "$srcdir/gklib-xopen-source.patch"
	patch -p1 -i "$srcdir/gklib-remove-test-with-embedded-assembler.patch"
}

build() {
	# GKlib is required by METIS (extracted as a git submodule by upstream).
	(
		cd GKlib
		mkdir -p build static-libs
		cd build
		cmake -G "Unix Makefiles" -DCMAKE_INSTALL_PREFIX=../static-libs \
			-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
			-DDEBUG=OFF -DOPENMP=set -DBUILD_SHARED_LIBS=OFF ..
		cmake --build . --config Release
cmake --install .
)
export CMAKE_GENERATOR="Unix Makefiles"
make config shared=1 gklib_path=GKlib/static-libs prefix=/usr
	make -j"$(nproc)"
}

package() {
	make DESTDIR="$pkgdir" install

	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

dev() {
	default_dev
}

